{
  "name": "untapped-search-console",
  "displayName": "Untapped Search Console",
  "version": "0.2.0",
  "description": "Reads your own Search Console: the queries and pages that bring clicks, the ones close to page one, what moved since last month, and the site's true totals. Free.",
  "author": {
    "name": "Find Untapped Growth",
    "url": "https://finduntappedgrowth.com/"
  },
  "homepage": "https://finduntappedgrowth.com/",
  "repository": "https://github.com/CTF-Max/untapped-plugins",
  "license": "MIT",
  "keywords": [
    "google",
    "search console",
    "search traffic",
    "queries",
    "clicks",
    "impressions"
  ],
  "icon": "./assets/untapped-search-console.svg",
  "documentationUrl": "https://github.com/CTF-Max/untapped-plugins/tree/main/untapped-search-console#readme",
  "supportUrl": "https://github.com/CTF-Max/untapped-plugins/issues",
  "privacyPolicyUrl": "https://github.com/CTF-Max/untapped-plugins/blob/main/untapped-search-console/PRIVACY.md",
  "mcpServers": {
    "untapped-search-console": {
      "command": "python",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/server/gsc_server.py"
      ],
      "env": {
        "UNTAPPED_GOOGLE_CLIENT_SECRET": "${UNTAPPED_GOOGLE_CLIENT_SECRET}",
        "UNTAPPED_GOOGLE_HOME": "${UNTAPPED_GOOGLE_HOME}",
        "UNTAPPED_GOOGLE_CLIENT_JSON": "${user_config.google_client_json}"
      }
    }
  },
  "userConfig": {
    "google_client_json": {
      "type": "file",
      "title": "Google OAuth client file",
      "description": "The Desktop-app OAuth client JSON you downloaded from Google Cloud console (APIs & Services → Credentials). Shared by every Untapped Google plugin. Leave empty if you set UNTAPPED_GOOGLE_CLIENT_SECRET instead."
    }
  }
}
